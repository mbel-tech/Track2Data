/* Track2Data — "Teal Field" light theme (starter QSS).
   Hook-ups: set objectName / dynamic properties as noted. Fonts must be
   registered with QFontDatabase before applying. */

* { font-family: "Atkinson Hyperlegible", "Segoe UI", "Helvetica Neue", Arial, sans-serif; font-size: 14px; color: #1d2b30; }
QMainWindow, QWidget#Page { background: #faf7f0; }

/* Menu bar */
QMenuBar { background: #16474f; color: #cfe2e4; font-size: 13px; padding: 2px 6px; }
QMenuBar::item { background: transparent; padding: 4px 9px; border-radius: 5px; color: #cfe2e4; }
QMenuBar::item:selected { background: rgba(255,255,255,0.10); }
QMenuBar::item:pressed { background: rgba(255,255,255,0.16); color: #ffffff; }
QMenu { background: #ffffff; border: 1px solid #e6dfd0; border-radius: 10px; padding: 5px; }
QMenu::item { padding: 6px 28px 6px 26px; border-radius: 6px; font-size: 13.5px; }
QMenu::item:selected { background: #f5f1e8; color: #1d2b30; }
QMenu::item:disabled { color: #6d7d81; }
QMenu::separator { height: 1px; background: #e6dfd0; margin: 5px 8px; }

/* Sidebar (QListView#StageList, custom delegate paints dot + summary) */
QListView#StageList { background: #1c5866; border: none; outline: 0; }
QWidget#SidebarHeader { background: #1c5866; }
QLabel#AppName { color: #ffffff; font-size: 17px; font-weight: 700; }
QLabel#ProjectSub { color: #a9cdd1; font-size: 12px; }

/* Page typography */
QLabel#PageTitle { font-size: 28px; font-weight: 700; }
QLabel#PageLead { font-size: 14.5px; color: #55676c; }
QLabel#SectionLabel { font-size: 12px; font-weight: 700; color: #6d7d81; letter-spacing: 1px; text-transform: uppercase; }
QLabel[role="faint"] { color: #6d7d81; font-size: 12.5px; }
QLabel[role="mono"] { font-family: "IBM Plex Mono", Consolas, Menlo, monospace; font-size: 13px; }

/* Buttons: property role = primary | accent | outline | link */
QPushButton { border-radius: 16px; padding: 8px 16px; font-weight: 700; font-size: 13px; }
QPushButton[role="primary"] { background: #1c5866; color: #ffffff; border: none; }
QPushButton[role="primary"]:hover { background: #22697a; }
QPushButton[role="accent"] { background: #f2c14e; color: #2a2205; border: none; }
QPushButton[role="accent"]:hover { background: #f5cb66; }
QPushButton[role="outline"] { background: transparent; color: #1d2b30; border: 1px solid #cfc6b3; }
QPushButton[role="outline"]:hover { background: #f5f1e8; }
QPushButton[role="outline-primary"] { background: transparent; color: #1c5866; border: 1px solid #1c5866; }
QPushButton:disabled { color: #6d7d81; background: transparent; border: 1px solid #e6dfd0; }

/* Inputs */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background: #ffffff; border: 1px solid #e6dfd0; border-radius: 10px; padding: 8px 12px; selection-background-color: #1c5866; }
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1.5px solid #1c5866; }
QLineEdit[invalid="true"], QDoubleSpinBox[invalid="true"] { border: 1.5px solid #d1453b; }
QLineEdit#Search { border-radius: 16px; padding: 8px 14px; }

/* Checkboxes */
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 2px solid #cfc6b3; background: transparent; }
QCheckBox::indicator:checked { background: #1c5866; border-color: #1c5866; image: url(:/icons/check-white.svg); }

/* Cards & tables */
QFrame[card="true"] { background: #ffffff; border: 1px solid #e6dfd0; border-radius: 12px; }
QFrame#DetailPane { background: #f3eee3; border-left: 1px solid #e6dfd0; }
QTableView, QTreeView, QListView#PlainList { background: #ffffff; border: 1px solid #e6dfd0; border-radius: 12px;
  gridline-color: transparent; selection-background-color: #eef5f5; selection-color: #1d2b30; outline: 0; }
QTableView::item { padding: 10px 8px; border-bottom: 1px solid #f2ede2; }
QTableView::item:hover { background: #f5f1e8; }
QHeaderView::section { background: #ffffff; color: #6d7d81; font-size: 12px; font-weight: 700; border: none;
  border-bottom: 1px solid #e6dfd0; padding: 10px 8px; }

/* Banners: QFrame[banner="ok|warn|err"] */
QFrame[banner="ok"] { background: #e1ecec; border-radius: 10px; }
QFrame[banner="warn"] { background: #fbefd0; border-radius: 10px; }
QFrame[banner="err"] { background: #f8e1dc; border-radius: 10px; }
QFrame[banner="warn"] QLabel { color: #6e4f00; }
QFrame[banner="err"] QLabel { color: #8e2a1e; }

/* Chips: QLabel[chip="ok|warn|err"] */
QLabel[chip] { border-radius: 11px; padding: 4px 11px; font-size: 12.5px; font-weight: 700; }
QLabel[chip="ok"] { background: #e1ecec; color: #1c5866; }
QLabel[chip="warn"] { background: #fbefd0; color: #6e4f00; }
QLabel[chip="err"] { background: #f8e1dc; color: #8e2a1e; }

/* Tabs (Preview: underline style) */
QTabBar::tab { background: transparent; color: #6d7d81; font-weight: 700; padding: 8px 14px; border: none; }
QTabBar::tab:selected { color: #1d2b30; border-bottom: 2px solid #1c5866; }
QTabWidget::pane { border: none; border-top: 1px solid #e6dfd0; }

/* Progress */
QProgressBar { background: #ece6d9; border: none; border-radius: 3px; height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #1c5866; border-radius: 3px; }

/* Footer bar & run-log drawer */
QFrame#FooterBar { background: #ffffff; border-top: 1px solid #e6dfd0; }
QPlainTextEdit#RunLog { background: #f3eee3; color: #3b4a4f; font-family: "IBM Plex Mono", Consolas, Menlo, monospace; font-size: 12px; border: none; border-top: 1px solid #e6dfd0; border-radius: 0; }

/* Dialogs */
QDialog { background: #ffffff; }
QFrame#DialogFooter { background: #f3eee3; border-top: 1px solid #e6dfd0; }

QToolTip { background: #1d2b30; color: #ffffff; border: none; padding: 6px 10px; border-radius: 6px; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #cfc6b3; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* Shell additions */
QLabel#Toast { background: #1d2b30; color: #ffffff; border-radius: 18px; padding: 10px 20px; font-weight: 700; }
QPushButton#ThemePill { background: rgba(255,255,255,0.10); color: #cfe2e4; border: none; border-radius: 11px; padding: 2px 12px; margin: 2px 8px; font-size: 12px; }
QPushButton[role="link"] { background: transparent; border: none; color: #55676c; font-weight: 400; padding: 8px 6px; }
QDockWidget { border: none; }
QStatusBar { background: #ffffff; }

/* Spin boxes and combos: subcontrols must be restyled once the frame is */
QSpinBox, QDoubleSpinBox { padding-right: 28px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/chevron-up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 10px; height: 10px; }
QComboBox { padding-right: 30px; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: center right; width: 28px; border: none; background: transparent; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { border: 1px solid #8a979b55; border-radius: 8px; padding: 4px; outline: 0; }

/* Scroll areas must not paint the platform palette behind themed pages */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QGroupBox { border: 1px solid #8a979b55; border-radius: 10px; margin-top: 12px; padding-top: 10px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }

QLabel[role="err"] { color: #8e2a1e; }
QTableView[dropActive="true"] { border: 2px solid #1c5866; }
QTableView::item:selected { background: #eef5f5; color: #1d2b30; }
QTableView::item { padding: 10px 4px; } QHeaderView::section { padding: 10px 4px; }
